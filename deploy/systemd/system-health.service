[Unit]
Description=Run system_health.sh and append the result to the health log

[Service]
Type=oneshot
LogsDirectory=system_health
ExecStart=/usr/local/bin/system_health.sh --log-file /var/log/system_health/health_log.txt
# Exit code 1 (warning) or 2 (critical) marks the unit as failed on purpose, so monitoring can see it.
